# 一组图片：输入目录内放一张彩图和多张掩码。
# 也可以在输入目录内为每一组建立一个子目录，程序会逐组处理。
SC_INPUT_DIR=E:/Projects/UCRT64C++/SplitColors/SplitSamples
SC_OUTPUT_DIR=E:/Projects/UCRT64C++/SplitColors/SplitLayers

# 可选：彩图文件名（不含目录）；留空自动识别彩色图。
# 多组处理时，此文件名必须在每个子目录中都存在；不同文件名时留空。
SC_SOURCE_IMAGE=

# 不透明黑白掩码：black 表示黑色是选区，white 表示白色是选区。
# 带透明区域的 PNG 掩码直接使用透明度，与此设置无关。
MASK_FOREGROUND=black

# soft 保留掩码灰度边缘并抑制轻微 JPEG 噪点；binary 只输出硬边缘。
MASK_EDGES=soft

# 仅 binary 模式使用：选区阈值，1 到 255，默认 128。
MASK_THRESHOLD=128
